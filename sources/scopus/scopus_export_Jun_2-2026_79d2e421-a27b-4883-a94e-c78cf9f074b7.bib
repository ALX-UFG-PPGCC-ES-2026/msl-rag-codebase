@ARTICLE{Antal202650878,
	author = {Antal, Gabor and Ertekes, Lorant and Szolnoki, Norbert and Hegedus, Peter},
	title = {Evaluating Retrieval-Augmented Generation for LLM-Based Vulnerability Detection: An Empirical Study on Real-World Java Vulnerabilities},
	year = {2026},
	journal = {IEEE Access},
	volume = {14},
	pages = {50878 - 50891},
