@ARTICLE{Shen2026,
	author = {Shen, Yuanyuan and Qin, Pinle and Zhao, Kaiyi and Zhang, Fuwei and Zhang, Fan and Li, Guiji},
	title = {Repository-level code completion with adaptive segmentation and fused retrieval},
