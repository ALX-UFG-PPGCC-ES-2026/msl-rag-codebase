@CONFERENCE{Qian20252366,
	author = {Qian, Hongjin and Liu, Zheng and Zhang, Peitian and Mao, Kelong and Lian, Defu and Dou, Zhicheng and Huang, Tiejun},
	title = {MemoRAG: Boosting Long Context Processing with Global Memory-Enhanced Retrieval Augmentation},
	year = {2025},
	journal = {WWW 2025 - Proceedings of the ACM Web Conference},
	pages = {2366 - 2377},
	doi = {10.1145/3696410.3714805},
	url = {https://www.scopus.com/pages/publications/105005152783?origin=resultslist},
	abstract = {Processing long contexts presents a significant challenge for large language models (LLMs). While recent advancements allow LLMs to handle much longer contexts than before (e.g., 32K or 128K tokens), it is computationally expensive and can still be insufficient for many applications. Retrieval-Augmented Generation (RAG) is considered a promising strategy to address this problem. However, conventional RAG methods face inherent limitations because of two underlying requirements: 1) explicitly stated queries, and 2) well-structured knowledge. These conditions, however, do not hold in general long-context processing tasks. In this work, we propose MemoRAG, a novel RAG framework empowered by global memory-augmented retrieval. MemoRAG features a dual-system architecture. First, it employs a light but long-range system to create a global memory of the long context. Once a task is presented, it generates draft answers, providing useful clues for the retrieval tools to locate relevant information within the long context. Second, it leverages an expensive but expressive system, which generates the final answer based on the retrieved information. Building upon this fundamental framework, we realize the memory module in the form of KV compression, and reinforce its memorization and cluing capacity from the Generation quality’s Feedback (a.k.a. RLGF). In our experiments, MemoRAG achieves superior performances across a variety of long-context evaluation tasks, not only complex scenarios where traditional RAG methods struggle, but also simpler ones where RAG is typically applied. Our source code is available at this repository. © 2025 Copyright held by the owner/author(s).},
	author_keywords = {Long Context Processing; Retrieval-Augmented Generation},
	keywords = {Condition; Context processing; Dual system; Generation method; Inherent limitations; Language model; Long context processing; Retrieval-augmented generation; Structured knowledge; Systems architecture},
	publisher = {Association for Computing Machinery, Inc},
	isbn = {979-840071274-6},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {All Open Access; Gold Open Access}
}

@CONFERENCE{Yarramallu2025,
	author = {Yarramallu, V S N Lokesh and Gangireddy, Rahul Jogi and Manne, Leela Naresh and Veena, G.},
	title = {HybridCode: A Dual-Database Framework for Intelligent Codebase Analysis and Article Generation},
	year = {2025},
	journal = {2025 5th Asian Conference on Innovation in Technology, ASIANCON 2025},
	pages = {},
	doi = {10.1109/ASIANCON66527.2025.11281189},
	url = {https://www.scopus.com/pages/publications/105031443246?origin=resultslist},
	abstract = {The exponential increase in software development complexity, along with the spread of large-scale software projects, has led to problematic situations not seen before in the history of the IT industry. These problems are related to software developers who are struggling with understanding, maintaining, and extending their existing software systems. The methods used by traditional codebase analysis significantly depend on manual inspection, static analysis instruments, and documentation systems, which are only partially consistent. They usually do not succeed in capturing the complex relationships between code components, architectural patterns, and semantic dependencies. This research work introduces a range of methods for intelligent codebase analysis, which involves a new dual-database architecture integrating vector and graph-based knowledge representation, converting raw code into structured knowledge representations. The project utilizes advanced content processing with Google Gemini LLM through structured prompt engineering, with an architecture that leverages Qdrant vector storage. Additionally, it employs the Neo4j graph database, featuring a four-layer node hierarchy that records both explicit code relationships and semantic associations. Our trials confirm the conceptual and detailed capabilities of the framework in the resolution of complex multi-step queries and relationship discovery. The infrastructure marks a significant milestone in the field of intelligent software analysis and developer productivity-enhancing tools, as it offers both semantic understanding through vector similarity and structural insights through graph traversal in a single conversational interface. The system also includes an intelligent article generation framework that uses neural quality assessment and multi-agent coordination to automatically create based on codebase analysis.  © 2025 IEEE.},
