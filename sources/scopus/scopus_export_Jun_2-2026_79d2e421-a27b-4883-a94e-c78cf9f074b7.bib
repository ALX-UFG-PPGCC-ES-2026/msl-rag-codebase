@CONFERENCE{Matloob2025,
	author = {Matloob, Youssef and Kamal, Hanan A. and Abdelkader, Nemat},
	title = {Unlocking Code Understanding: A Local-First Hybrid Knowledge Graph Approach},
	year = {2025},
	journal = {International Conference on Computer and Applications, ICCA 2025 - Proceedings},
	pages = {},
	doi = {10.1109/ICCA66035.2025.11430945},
	url = {https://www.scopus.com/pages/publications/105036977689?origin=resultslist},
	abstract = {Modern enterprise software development is often hampered by the immense complexity of large-scale, proprietary codebases. While Large Language Models (LLMs) offer a path to automate complex software development tasks, their application is frequently limited by context window sizes and critical security concerns over sending source code to external APIs. In this paper, we present a novel, local-first AI agent designed to integrate into modern Integrated Development Environments (IDEs) and build a deep, contextual understanding of codebases while preserving data privacy. The cornerstone of our system is a hybrid knowledge graph that synergistically combines a structured, AI-generated symbolic representation of the code with a dense semantic vector index, all running on the developer's local machine. We introduce a distributed worker architecture that parallelizes the expensive analysis and indexing process across multiple worker processes. Our evaluation demonstrates that this parallel architecture significantly reduces analysis time compared to sequential methods. Furthermore, we show that our hybrid retrieval method provides more accurate and relevant context for downstream code generation tasks than either purely symbolic or purely semantic approaches. Our work presents a practical and secure architecture for embedding powerful, context-aware AI assistants directly within an enterprise development environment, enabling advanced task automation without compromising code privacy. © 2025 IEEE.},
	author_keywords = {Agentic AI; Developer Tools; Large Language Models; Local-First AI; Retrieval-Augmented Generation; Software Engineering; Static Analysis},
	keywords = {Application programming interfaces (API); Automatic programming; Codes (symbols); Computer aided software engineering; Computer programming languages; Data privacy; Enterprise software; Parallel architectures; Semantics; Software design; Agentic AI; Code understanding; Developer tool; Hybrid knowledge; Knowledge graphs; Language model; Large language model; Local-first AI; Retrieval-augmented generation; Workers'; Static analysis},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833159953-9},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus}
}

@CONFERENCE{Meshram202541,
	author = {Meshram, Pallavi and Nanwani, Jaya and Bondre, Shweta and Devda, Kshitij and Shahane, Prem and Bhatt, Shreyash and Mankar, Atharav},
	title = {RAG-Enhanced Semantic Code Retrieval & AI-Enhanced Communication for Developer Efficiency},
	year = {2025},
	journal = {OCIT 2025 - Proceedings 23rd OITS International Conference on Information Technology},
	pages = {41 - 46},
	doi = {10.1109/OCIT66168.2025.11400280},
	url = {https://www.scopus.com/pages/publications/105036704532?origin=resultslist},
	abstract = {GitHub Repository Supporter is a high-tech AI solution that helps software engineering teams deal with challenges like managing complex, multi-tiered codebases and working collaboratively from different locations. A lot of the time, regular tools don't do a good job at automating chores or understanding the situation, which renders them useless. Retrieval-Augmented Generation (RAG) and Large Language Models (LLMs) are used by this platform to search for semantic code. This enables developers ask questions about repositories in plain English, so they don't have to pore through the code by hand. It also finds flaws, variables, and functions in the code. It has Whisper ASR to transcribe conference audio and video so that teams can work together better, and Google Gemini AI creates summaries that are organized and time-stamped. It has a modular design that makes it easy to find your way around repositories, write documentation automatically, and collaborate together. This paper talks about the system architecture and AI methodologies, focusing on how intelligent automation may make work more productive and transform the way software is made. © 2025 IEEE.},
