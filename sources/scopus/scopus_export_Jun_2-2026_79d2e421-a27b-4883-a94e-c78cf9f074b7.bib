@ARTICLE{Li2026,
	author = {Li, Changjin and Jing, Fengshi and Li, Huarun and Dong, Zheng and Xu, Zhougzhi and Zou, Huiru and Wang, Qiting and He, Jie and Qian, Yuchen and Cao, Boyu and Liu, Wenjian and Qin, Si and Cheng, Weibin and Zhang, Haobin},
	title = {Medical multi-recall embedding: Adaptive retrieval for diverse evidence in medical RAG systems},
	year = {2026},
	journal = {Information Processing and Management},
	volume = {63},
	number = {5},
	pages = {},
	doi = {10.1016/j.ipm.2026.104695},
	url = {https://www.scopus.com/pages/publications/105032747237?origin=resultslist},
	abstract = {Large language models have demonstrated promising capabilities in medical question answering but frequently generate unreliable or hallucinated content. Retrieval-Augmented Generation (RAG) addresses this issue by incorporating external knowledge, yet its effectiveness critically depends on retrieval quality. Existing medical retrievers are typically trained under a restrictive one-to-one paradigm, where each query is paired with a single document, failing to reflect the complexity of real-world clinical scenarios that often require synthesizing information from multiple complementary sources. To address this limitation, we introduce a specialized multi-document medical retrieval dataset comprising 6273 queries paired with approximately 20,810 annotated passages spanning five clinical domains: general practice, cardiology, dermatology, breast tumor, and ophthalmology. Each query is associated with multiple clinically relevant documents that provide diverse yet complementary perspectives. Leveraging this dataset, we propose the Medical Multi-Recall Embedding (MMRE) model, which employs a one-to-many retrieval strategy enhanced by a novel Adaptive Multi-Recall Loss (AMR Loss). AMR Loss introduces three components–Adaptive Positive Margin, Difficulty-Aware Weighting, and Loss Normalization–and ablation studies on each component demonstrate that all three contribute effectively and work synergistically. Extensive retrieval experiments demonstrate that MMRE substantially outperforms competitive baselines across all evaluation metrics and domains. On average across five domains, MMRE achieves more than 10 percentage point gains in Recall@10 and significant improvements in Hit Rate, MRR@10, and NDCG@10. Furthermore, when integrated into a RAG pipeline with a frozen language model, MMRE considerably improves downstream clinical question answering accuracy by at least 4 percentage points across all specialties, underscoring its effectiveness in enhancing the factual reliability and clinical relevance of LLM-generated medical answers. The constructed dataset and source code are publicly availablehttps://github.com/WVKerl/Medical-one-to-many-data. © 2026 Elsevier Ltd. All rights are reserved, including those for text and data mining, AI training, and similar technologies.},
	author_keywords = {Adaptive multi-recall loss; Large language models; Medical multi-recall embedding; Medical retrieval system; Retrieval-Augmented Generation},
	keywords = {Information retrieval; Information retrieval systems; Query processing; Search engines; Adaptive multi-recall loss; Embeddings; Language model; Large language model; Medical multi-recall embedding; Medical retrieval; Medical retrieval system; Percentage points; Retrieval systems; Retrieval-augmented generation; Data mining},
	publisher = {Elsevier Ltd},
	issn = {03064573},
	coden = {IPMAD},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus}
}

@ARTICLE{Ali2025295,
	author = {Ali, Syed Juned and Naganathan, Varun and Bork, Dominik},
	title = {Establishing Traceability Between Natural Language Requirements and Software Artifacts by Combining RAG and LLMs},
	year = {2025},
	journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics) },
	volume = {15238 LNCS},
	pages = {295 - 314},
	doi = {10.1007/978-3-031-75872-0_16},
	url = {https://www.scopus.com/pages/publications/85209545892?origin=resultslist},
	abstract = {Software Engineering aims to effectively translate stakeholders’ requirements into executable code to fulfill their needs. Traceability from natural language use case requirements to classes in a UML class diagram, subsequently translated into code implementation, is essential in systems development and maintenance. Tasks such as assessing the impact of changes and enhancing software reusability require a clear link between these requirements and their software implementation. However, establishing such links manually across extensive codebases is prohibitively challenging. Requirements, typically articulated in natural language, embody semantics that clarify the purpose of the codebase. Conventional traceability methods, relying on textual similarities between requirements and code, often suffer from low precision due to the semantic gap between high-level natural language requirements and the syntactic nature of code. The advent of Large Language Models (LLMs) provides new methods to address this challenge through their advanced capability to interpret both natural language and code syntax. Furthermore, representing code as a knowledge graph facilitates the use of graph structural information to enhance traceability links. This paper introduces an LLM-supported retrieval augmented generation approach for enhancing requirements traceability to the class diagram of the code, incorporating keyword, vector, and graph indexing techniques, and their integrated application. We present a comparative analysis against conventional methods and among different indexing strategies and parameterizations on the performance. Our results demonstrate how this methodology significantly improves the efficiency and accuracy of establishing traceability links in software development processes. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
	author_keywords = {Large Language Models; LLM; Requirements Engineering; Requirements Traceability; Retrieval Augmented Generation},
	keywords = {Application programs; Computer software maintenance; Computer software reusability; High level languages; Indexing (materials working); Indexing (of information); Knowledge graph; Program translators; Requirements engineering; Reusability; Search engines; Software design; Syntactics; Translation (languages); Language model; Large language model; Natural language requirements; Natural languages; Requirement engineering; Requirements traceability; Retrieval augmented generation; Traceability links; Semantics},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	issn = {03029743},
	isbn = {978-303175871-3},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus}
}

@CONFERENCE{Carthen2025238,
	author = {Carthen, Chase and Lac, Lukas and White, Rich and Braun, Thomas and Ochoa, Josue and Tavakkoli, Alireza and Harris, Frederick C.},
	title = {N-CATS: A Neural Network Classification Automatic Taxonomy System},
	year = {2025},
	journal = {Proceedings - 29th IEEE/ACIS International Conference on Software Engineering, Artificial Intelligence, Networking and Parallel/Distributed Computing, SNPD 2025-Summer},
	pages = {238 - 243},
	doi = {10.1109/SNPD65828.2025.11254174},
	url = {https://www.scopus.com/pages/publications/105031173596?origin=resultslist},
	abstract = {The rapid evolution of Artificial Neural Networks (ANN) has made it difficult to organize and compare model architectures under a unified framework. Automatic taxonomy construction (ATC) is a promising approach for algorithmically organizing knowledge domains, but existing frameworks struggle with the structural complexities of ANNs. To address this, we introduce Neural Network Classification Automatic Taxonomy System (N-CATS), a structured, ontology-driven framework for ATC that enables comparison across diverse ANN topologies. N-CATS extracts contextual information from semi-structured sources, including academic publications, source code, and serialized formats such as ONNX to populate an ontology schema-based on ANNETT-O. The system leverages Large Language Models (LLM) with Retrieval-Augmented Generation (RAG) to support the ontology population and organize extracted information in a graph database, enabling on-demand categorization and comparison of ANNs. To demonstrate feasibility, we developed a web application that provides ontology visualization, proof-of-concept taxonomy generation, and a chatbot using GraphRAG and Model Context Protocol (MCP) servers for intelligent querying. We compare N-CATS with existing neural network ontologies such as FAIRnets, Artificial Intelligence Ontology (AIO), and ANNETT-O. Finally, we outline advantages and limitations, demonstrating a proof-of-concept knowledge system that facilitates more efficient discovery and comparison of deep learning models as a tool for researchers.  © 2025 IEEE.},
	author_keywords = {Automatic Taxonomy Construction; Model Context Protocol; Neural Network; Ontology; Retrieval Augmented Generation},
	keywords = {Classification (of information); Data mining; Deep learning; Information retrieval; Internet protocols; Knowledge based systems; Knowledge organization; Query processing; Search engines; Structured Query Language; Topology; Automatic taxonomy construction; Model context protocol; Model contexts; Modeling architecture; Network classification; Neural network classification; Neural-networks; Ontology's; Proof of concept; Retrieval augmented generation; Ontology},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833151258-3},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus}
}

