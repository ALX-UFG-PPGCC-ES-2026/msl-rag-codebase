	title = {GPT4Rehab: AI-Based Upper-Limb Rehabilitation Trainer with Stereo Cameras},
	year = {2025},
	journal = {Proceedings of IEEE Sensors},
	pages = {},
	doi = {10.1109/SENSORS59705.2025.11330290},
	url = {https://www.scopus.com/pages/publications/105034145740?origin=resultslist},
	abstract = {Due to injuries, aging, or illness, individuals who have lost physical or cognitive abilities need rehabilitation to regain motor function and prevent complications. Range-of-motion exercises like shoulder flexion, wrist extension, and hip abduction are essential physical rehabilitation methods and are usually customized to individual needs and goals. Stereo vision system can help reconstruct the three-dimensional scene and be used to accurately capture body movements. Multi-modal large language models have gained significant performance improvement over the past several years. Rehabilitation assistive devices typically rely on monitoring patient's activities. To this end, this work explores a potential use case of a stereo vision based rehabilitation assistive device that incorporates vision-language models (VLMs), AI-based vision models, and retrieval-augmented generation (RAG). A VLM with strong reasoning capability can act as a rehabilitation assistant. AI-based specialized vision models perform to detect body joint landmarks and can reconstruct the 3D visible surface using a stereo camera rig. The results can be used to assess the joint mobility of a patient. With real-time AI-based stereo matching algorithm, we observe improved 3D perception on a stereo vision system compared to traditional vision techniques. On the system level, this work demonstrates an application for hand extension task. The application can assess motor mobility and provide customized feedback that help patients to regain mobilities. The source code will be available at https://github.com/zikaliu/RehabGPT. © 2025 IEEE.},
	author_keywords = {artificial intelligence; RAG; rehabilitation; VLM},
	keywords = {Computer vision; Joints (anatomy); Neuromuscular rehabilitation; Patient monitoring; Stereo image processing; Stereo vision; Three dimensional computer graphics; Vision aids; Assistive devices; Cognitive ability; Language model; Motor function; Retrieval-augmented generation; Stereo cameras; Stereo vision system; Upper-limb rehabilitation; Vision model; Vision-language model; Cameras},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
